rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return exists(/databases/$(database)/documents/cfg/admin)
        && get(/databases/$(database)/documents/cfg/admin).data.uid == request.auth.uid;
    }
    match /cfg/admin {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/cfg/admin)
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email == 'aazakobazar@gmail.com';
    }
    match /pub/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin())
        && request.resource.data.j is string && request.resource.data.j.size() < 60000;
    }
    match /priv/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin())
        && (request.method == 'get' || request.resource.data.j.size() < 60000);
    }
    match /dir/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // PDF Table 4.2.2 SHOPS TABLE
    match /shops/{sid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PDF Table 4.2.3 PRODUCTS TABLE
    match /products/{pid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PDF Table 4.2.4 ORDERS TABLE
    match /orders/{oid} {
      allow read: if true;
      allow create, update: if true;
    }

    // PDF Table 4.2.6 CHAT TABLE (Real-time live messaging between buyers and merchants)
    match /chats/{msgId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && isAdmin();
    }

    // PDF Table 4.2.5 KHATA TABLE (Digital ledger)
    match /khata/{kid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && isAdmin();
    }

    // PDF Table 4.2.5 VIDEOS TABLE (Video Bazar Feed)
    match /videos/{vid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PDF Table 4.2.4 PAYMENTS TABLE
    match /pays/{pid} {
      allow read: if true;
      allow create, update: if true;
    }

    match /logins/{lid} {
      allow create: if true;
      allow read: if request.auth != null && isAdmin();
    }

    match /profs/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /imgs/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /approvals/{uid} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /inquiries/{inqId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null && isAdmin();
    }
  }
}
